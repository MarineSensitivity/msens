{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marinesensitivity.org/schema/app_table.schema.json",
  "title": "the descriptor every app/*.parquet builder returns and validates",
  "description": "A Parquet file cannot be JSON-validated, so its COLUMN CONTRACT is. `columns` is the declared normalized schema in order; a builder that silently drops or renames a column fails here rather than in the browser.",
  "type": "object",
  "required": ["schema", "ver", "name", "path", "bytes", "rows", "columns", "digest"],
  "additionalProperties": false,
  "properties": {
    "schema":  { "type": "integer", "minimum": 1 },
    "ver":     { "type": "string", "pattern": "^v[0-9]+[a-z]?$" },
    "name":    { "type": "string" },
    "path":    { "type": "string" },
    "bytes":   { "type": "integer", "minimum": 0 },
    "rows":    { "type": "integer", "minimum": 0 },
    "digest":  { "type": "string", "minLength": 8 },
    "partitioned_by": { "type": ["string", "null"] },
    "files":   { "type": ["integer", "null"], "minimum": 0 },
    "columns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
